# --- REQUIRED: Supabase (Auth & Database) ---
# Client-side (VITE_ prefix makes them available to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side ONLY (Used for administrative tasks, bypasses RLS)
# DO NOT COMMIT THIS TO SOURCE CONTROL
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- REQUIRED: Google Gemini AI (Chatbot & Triage) ---
# Server-side ONLY
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- LEGACY/OPTIONAL: Azure OpenAI ---
# Only needed if you are still using the legacy Azure integration.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# --- LEGACY/OPTIONAL: Standard OpenAI ---
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_CHAT_MODEL=gpt-4o-mini
